# Copy to .env.local and fill in. Both are public by design: the anon key only
# allows what row-level security permits. Never put a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The site's public address, for the sitemap, canonical links, and share
# images. Defaults to https://coinodyssey.app. Set it in Vercel at launch.
NEXT_PUBLIC_SITE_URL=
